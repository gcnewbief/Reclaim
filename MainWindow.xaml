<Window x:Class="Reclaim.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reclaim — data recovery" Height="720" Width="1100"
        Icon="icon.ico"
        Background="#0a0e0a" Foreground="#d9ffe4"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#101510"/>
        <SolidColorBrush x:Key="Border" Color="#1d2b1d"/>
        <SolidColorBrush x:Key="Green" Color="#00e676"/>
        <SolidColorBrush x:Key="Teal" Color="#69f0ae"/>
        <SolidColorBrush x:Key="Dim" Color="#6f8f76"/>
        <SolidColorBrush x:Key="Orange" Color="#ffab40"/>
        <SolidColorBrush x:Key="Red" Color="#ff5252"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1a2b1a"/>
            <Setter Property="Foreground" Value="{StaticResource Teal}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#274427"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#101510"/>
            <Setter Property="Foreground" Value="#d9ffe4"/>
            <Setter Property="BorderBrush" Value="#1d2b1d"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#101510" BorderBrush="#1d2b1d"
                                                BorderThickness="1" CornerRadius="4">
                                            <Path x:Name="Arrow" Data="M 0 0 L 6 6 L 12 0 Z"
                                                  Fill="#69f0ae" Width="10" Height="6"
                                                  HorizontalAlignment="Right" Margin="0,0,10,0"
                                                  VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#162216"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                Margin="10,6,28,6" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <TextBox x:Name="PART_EditableTextBox" Visibility="Hidden"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"/>
                            <Popup x:Name="Popup" Placement="Bottom" Focusable="False"
                                   AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Slide">
                                <Grid MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                      Background="#101510">
                                    <Border BorderBrush="#1d2b1d" BorderThickness="1" CornerRadius="4"/>
                                    <ScrollViewer Margin="1" SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="#d9ffe4"/>
                    <Setter Property="Padding" Value="8,5"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#1b5e20"/>
                                    </Trigger>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#1b5e20"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Style.Resources>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0c110c"/>
            <Setter Property="Foreground" Value="#d9ffe4"/>
            <Setter Property="BorderBrush" Value="#1d2b1d"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="CaretBrush" Value="#00e676"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#0c110c"/>
            <Setter Property="Foreground" Value="#d9ffe4"/>
            <Setter Property="BorderBrush" Value="#1d2b1d"/>
            <Setter Property="RowBackground" Value="#0c110c"/>
            <Setter Property="AlternatingRowBackground" Value="#101510"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#1d2b1d"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Extended"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#101510"/>
            <Setter Property="Foreground" Value="#69f0ae"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#1d2b1d"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1b5e20"/>
                    <Setter Property="Foreground" Value="#eaffea"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#162216"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#0c110c"/>
        </Style>
        <Style TargetType="TreeView">
            <Setter Property="Background" Value="#0c110c"/>
            <Setter Property="Foreground" Value="#d9ffe4"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="#d9ffe4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <ToggleButton x:Name="Expander" ClickMode="Press" Focusable="False"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay,
                                                RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Path x:Name="Arrow" Data="M 0 0 L 8 4 L 0 8 Z" Fill="#6f8f76"
                                              Width="7" Height="8" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border x:Name="Bd" Grid.Column="1" Padding="2,1" Background="Transparent">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1"
                                            Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#162216"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1b5e20"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#101510"/>
            <Setter Property="Foreground" Value="#69f0ae"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="#1d2b1d"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="◈ RECLAIM" Foreground="{StaticResource Green}"
                       FontFamily="Consolas" FontSize="20" FontWeight="Bold"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="VersionLbl" Foreground="{StaticResource Dim}"
                       FontFamily="Consolas" FontSize="12" Margin="8,0,0,0"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="AdminNote" Text="  (admin required for raw disk access)"
                       Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- controls -->
        <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Drive:" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                    <ComboBox x:Name="DriveList" Width="420" Margin="8,0,12,0"
                              DisplayMemberPath="Label"
                              SelectionChanged="DriveList_SelectionChanged"/>
                    <Border x:Name="DriveLightBox" Padding="8,3" Background="#101510"
                            BorderBrush="{StaticResource Border}" BorderThickness="1"
                            CornerRadius="4" VerticalAlignment="Center"
                            ToolTipService.ShowDuration="20000">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DriveLight" Width="12" Height="12"
                                     Fill="#3a4a3a" Stroke="#0a0e0a" StrokeThickness="1"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="DriveLightLbl" Text="drive health: —"
                                       Foreground="{StaticResource Dim}" FontSize="11"
                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="RefreshBtn" Content="⟳ Refresh" Margin="8,0,0,0" Click="Refresh_Click"/>
                    <Button x:Name="ScanBtn" Content="▶ SCAN" Margin="14,0,0,0" Click="ScanBtn_Click"/>
                    <Button x:Name="DeepOnlyBtn" Content="DEEP SCAN ONLY" Margin="8,0,0,0" Click="DeepOnly_Click"
                            ToolTip="Skip triage/MFT - go straight to signature carving"/>
                    <Button x:Name="SmartBtn" Content="⛑ SMART" Margin="8,0,0,0" Click="Smart_Click"
                            ToolTip="Drive SMART health attributes"/>
                    <Button x:Name="CancelBtn" Content="✕ CANCEL" Margin="8,0,0,0" IsEnabled="False" Click="Cancel_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Filter:" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                    <TextBox x:Name="FilterBox" Width="320" Margin="8,0,12,0" TextChanged="Filter_Changed"/>
                    <CheckBox x:Name="DeletedOnly" Content="deleted only" Foreground="{StaticResource Dim}"
                              VerticalAlignment="Center" IsChecked="False" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                    <TextBlock x:Name="CountLbl" Margin="16,0,0,0" Foreground="{StaticResource Dim}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="HealthLbl" Margin="16,0,0,0" Foreground="{StaticResource Teal}"
                               VerticalAlignment="Center" FontFamily="Consolas" FontSize="11"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Recover to:" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                    <TextBox x:Name="OutDir" Width="420" Margin="8,0,8,0" Text=""
                             ToolTip="Pick a folder on a DIFFERENT physical drive"/>
                    <Button Content="…" Click="Browse_Click"/>
                    <Button x:Name="RecoverBtn" Content="▼ RECOVER SELECTED" Margin="14,0,0,0"
                            Foreground="{StaticResource Green}" IsEnabled="False" Click="Recover_Click"/>
                    <TextBlock Text="  (must be a different physical drive)"
                               Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- volumes (tier-0 triage) -->
        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,10">
            <ListView x:Name="VolList" Height="86" Background="Transparent" BorderThickness="0"
                      Foreground="#d9ffe4" FontFamily="Consolas" FontSize="11">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Offset" DisplayMemberBinding="{Binding OffsetHex}" Width="110"/>
                        <GridViewColumn Header="Size" DisplayMemberBinding="{Binding SizeHuman}" Width="90"/>
                        <GridViewColumn Header="FS" DisplayMemberBinding="{Binding FsName}" Width="90"/>
                        <GridViewColumn Header="Verdict" DisplayMemberBinding="{Binding Verdict}" Width="500"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- results: folder tree (left) + file grid (right) -->
        <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" MinWidth="140"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*" MinWidth="320"/>
                </Grid.ColumnDefinitions>

                <TreeView x:Name="FolderTree" Margin="4" FontFamily="Consolas" FontSize="12"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          SelectedItemChanged="FolderTree_Selected">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox VerticalAlignment="Center" IsThreeState="True"
                                          IsChecked="{Binding IsChecked, Mode=OneWay}"
                                          PreviewMouseLeftButtonDown="FolderCheck_Preview"
                                          Click="FolderCheck_Click"/>
                                <TextBlock Text="{Binding Name}" Margin="4,0,0,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CountText}" Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource Dim}" FontSize="10"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"
                              Background="#1d2b1d"/>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="Grid" SelectionChanged="Grid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Width="36"
                                Binding="{Binding Checked, UpdateSourceTrigger=PropertyChanged}">
                            <DataGridCheckBoxColumn.Header>
                                <CheckBox x:Name="CheckAll" HorizontalAlignment="Center"
                                          Checked="CheckAll_Changed" Unchecked="CheckAll_Changed"
                                          ToolTip="check/uncheck all filtered files"/>
                            </DataGridCheckBoxColumn.Header>
                            <DataGridCheckBoxColumn.ElementStyle>
                                <Style TargetType="CheckBox">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridCheckBoxColumn.ElementStyle>
                            <DataGridCheckBoxColumn.EditingElementStyle>
                                <Style TargetType="CheckBox">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridCheckBoxColumn.EditingElementStyle>
                        </DataGridCheckBoxColumn>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                        <DataGridTextColumn Header="Path" Binding="{Binding FolderPath}" Width="2.5*"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding Size, StringFormat={}{0:N0}}" Width="110"/>
                        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="80"/>
                        <DataGridTextColumn Header="Health" Binding="{Binding Health}" Width="80"/>
                        <DataGridTextColumn Header="Src" Binding="{Binding Source}" Width="70"/>
                        <DataGridTextColumn Header="Rec#" Binding="{Binding RecordNum}" Width="80"/>
                    </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="DetailLbl" Grid.Row="1" Margin="8,4" Foreground="{StaticResource Dim}"
                               FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                               Text="select a file for details"/>
                </Grid>
            </Grid>
        </Border>

        <!-- diagnostic log -->
        <Border Grid.Row="4" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,8,0,0" Height="96">
            <TextBox x:Name="LogBox" IsReadOnly="True" BorderThickness="0" Background="#0c110c"
                     Foreground="{StaticResource Teal}" FontFamily="Consolas" FontSize="11"
                     VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
        </Border>

        <!-- status -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,8,0,0">
            <ProgressBar x:Name="Prog" Width="320" Height="10" Minimum="0" Maximum="1000"
                         Foreground="{StaticResource Green}" Background="#0c110c"
                         VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusLbl" Margin="12,0,0,0" Foreground="{StaticResource Dim}"
                       VerticalAlignment="Center" Text="Pick a drive and scan. Nothing is ever written to the source disk."/>
        </StackPanel>
    </Grid>
</Window>
